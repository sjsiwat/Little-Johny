# Cloudflare Workers secrets (worker.js)
# Set with: npx wrangler secret put <NAME>   (non-secret vars live in wrangler.toml [vars])

# LINE Login channel (create at developers.line.biz → LINE Login channel)
LINE_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET

# Supabase (get from Supabase dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
