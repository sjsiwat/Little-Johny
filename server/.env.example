# ── Cloudflare Workers secrets (server/worker.js) ─────────────────────────
# Set with: npx wrangler secret put <NAME>
# Non-secret vars live in wrangler.toml (repo root) under [vars].

LINE_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Client build (optional) ───────────────────────────────────────────────
# src/lib/supabaseClient.js falls back to the public project values, so these
# are only needed to point the build at a different Supabase project.
# Put them in .env.local at the repo root.

# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# VITE_LINE_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
